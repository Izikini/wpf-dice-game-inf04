<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kosci.MainPage"
             BackgroundColor="Beige">

    <StackLayout BackgroundColor="Beige">
        <Label Text="Gra w kości. Autor: Bohdan Bura" BackgroundColor="Brown" TextColor="White" Padding="10" Margin="0,10,0,10" FontSize="Title"></Label>
        <Button x:Name="losowanie" Text="RZUĆ KOŚĆMI" BackgroundColor="Chocolate" HorizontalOptions="Center" Margin="0,10,0,10" Clicked="Losowanie_Clicked"></Button>
        <HorizontalStackLayout BackgroundColor="White" HorizontalOptions="Center">
            <Image x:Name="kostka_img1" Source="question.jpg" HeightRequest="60" Margin="9"/>
            <Image x:Name="kostka_img2" Source="question.jpg" HeightRequest="60" Margin="9"/>
            <Image x:Name="kostka_img3" Source="question.jpg" HeightRequest="60" Margin="9"/>
            <Image x:Name="kostka_img4" Source="question.jpg" HeightRequest="60" Margin="9"/>
            <Image x:Name="kostka_img5" Source="question.jpg" HeightRequest="60" Margin="9"/>
        </HorizontalStackLayout>
        <Label x:Name="wynik" Text="Wynik tego losowania: " HorizontalOptions="Center" TextColor="Black" Margin="0,10,0,10"></Label>
        <Label x:Name="wynik_gry" Text="Wynik gry: " HorizontalOptions="Center" TextColor="Black" Margin="0,10,0,10"></Label>
        <Button x:Name="reset" Text="RESETUJ WYNIK" BackgroundColor="Chocolate" HorizontalOptions="Center" Clicked="Reset_Clicked"></Button>
    </StackLayout>
</ContentPage>